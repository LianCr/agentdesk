{
  "name": "agentdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentDesk demo — bilingual insurance knowledge assistant. M1: data contract and PDF generation for fictional demonstration products.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "generate:pdfs": "tsx scripts/generate-product-pdfs.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "validate:pdfs": "tsx scripts/validate-product-pdfs.ts",
    "render:pages": "tsx scripts/render-pdf-pages.ts",
    "extract:documents": "tsx scripts/extract-documents.ts",
    "validate:chunks": "tsx scripts/validate-chunks.ts",
    "ingest:products": "tsx scripts/ingest-products.ts",
    "delete:document": "tsx scripts/delete-document.ts",
    "retrieve": "tsx scripts/retrieve.ts",
    "calibrate:retrieval": "tsx scripts/calibrate-retrieval.ts",
    "test:retrieval": "vitest run --config vitest.live.config.ts",
    "validate:ingestion": "tsx scripts/validate-ingestion.ts",
    "test": "vitest run",
    "test:embeddings": "vitest run tests/embeddings",
    "test:embeddings:live": "vitest run --config vitest.smoke.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.34",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^7.0.56",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "supabase": "^2.111.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
