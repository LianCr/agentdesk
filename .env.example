# AgentDesk server-side environment. Copy to .env and fill in.
# .env is git-ignored; never commit real values anywhere.

# Supabase project URL (Settings -> API)
SUPABASE_URL=

# Supabase SECRET key (sb_secret_*). Server-side only: never expose to a
# browser, client bundle, log or error message.
SUPABASE_SECRET_KEY=

# OpenAI API key. Not used by M2-B; required from M2-C (embeddings) on.
OPENAI_API_KEY=
